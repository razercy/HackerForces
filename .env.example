# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# On Vercel, set these under Project Settings → Environment Variables.

# Neon Postgres. Use the *pooled* connection string (host contains "-pooler").
# For local development, create a separate Neon branch (e.g. "dev") so you never touch production data.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/hackerforces?sslmode=verify-full"

# Better Auth. Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Public origin of this app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Optional: password for `npm run seed` demo accounts (local development only).
SEED_DEMO_PASSWORD="replace-with-a-local-only-password"

# Judge. Only "mock" exists until the sandboxed judge is integrated; it never runs submitted code.
JUDGE_PROVIDER="mock"
# Artificial mock latency (ms) so queued → running → judged is visible in the UI.
MOCK_JUDGE_DELAY_MS="1500"
# Bearer token for /api/cron/judge (Vercel Cron sends it automatically when set). 16+ chars.
CRON_SECRET="replace-with-a-random-string"
# Days to keep raw editor telemetry and periodic snapshots (purged by /api/cron/retention).
TELEMETRY_RETENTION_DAYS="180"

# Real judge (see docs/judge.md). Leave JUDGE_PROVIDER="mock" until a Judge0 VM is provisioned.
# JUDGE_PROVIDER="judge0"
# JUDGE0_URL="https://judge.example.com"
# JUDGE0_AUTH_TOKEN="replace-with-openssl-rand-hex-32"
# JUDGE0_CPP_LANGUAGE_ID="54"
# Ceilings matching MAX_STACK_LIMIT / MAX_MEMORY_LIMIT in your judge0.conf (KB). Defaults are stock Judge0.
# infra/judge/judge0.conf.example raises them to 262144 / 1048576; set these to match if you use it.
# JUDGE0_MAX_STACK_KB="128000"
# JUDGE0_MAX_MEMORY_KB="512000"
