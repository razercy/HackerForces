{
  "name": "hackerforces",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "grant-role": "tsx --conditions=react-server scripts/grant-role.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "analyze": "tsx --conditions=react-server scripts/analyze.ts",
    "eval:generate": "tsx eval/generate.ts",
    "eval:run": "node scripts/eval-run.mjs",
    "eval": "npm run eval:generate && npm run eval:run",
    "eval:test": "node scripts/eval-test.mjs",
    "judge:check": "tsx --conditions=react-server scripts/judge-check.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@vercel/functions": "^3.10.1",
    "better-auth": "^1.7.10",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
