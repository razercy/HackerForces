# Judge0 CE 1.13.1 configuration for HackerForces.
# Copy to judge0.conf (never commit it). Variable names follow the judge0.conf
# shipped with the 1.13.1 release; re-check them against that file when upgrading.

# ---------------------------------------------------------------- authentication
# The app sends this in X-Auth-Token. Generate with: openssl rand -hex 32
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=replace-with-64-hex-chars
# Separate token for admin endpoints (workers, statistics). Not used by the app.
AUTHZ_HEADER=X-Auth-User
AUTHZ_TOKEN=replace-with-another-64-hex-chars

# ---------------------------------------------------------------- features (least privilege)
ENABLE_WAIT_RESULT=false
ENABLE_COMPILER_OPTIONS=true
ALLOWED_LANGUAGES_FOR_COMPILE_OPTIONS=C++ (GCC 9.2.0)
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_SUBMISSION_DELETE=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
ENABLE_BATCHED_SUBMISSIONS=true
MAX_SUBMISSION_BATCH_SIZE=20
MAX_QUEUE_SIZE=200
USE_DOCS_AS_HOMEPAGE=false

# ---------------------------------------------------------------- sandbox limits (hard caps)
# The app requests per-problem limits; these are ceilings it cannot exceed.
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=10
CPU_EXTRA_TIME=0.5
MAX_CPU_EXTRA_TIME=2
WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=30
MEMORY_LIMIT=262144
MAX_MEMORY_LIMIT=1048576
STACK_LIMIT=65536
MAX_STACK_LIMIT=262144
MAX_PROCESSES_AND_OR_THREADS=8
MAX_MAX_PROCESSES_AND_OR_THREADS=16
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=4096
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
REDIRECT_STDERR_TO_STDOUT=false

# ---------------------------------------------------------------- internal services
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=replace-with-random

# Workers per container (each runs one sandbox at a time).
COUNT=2
